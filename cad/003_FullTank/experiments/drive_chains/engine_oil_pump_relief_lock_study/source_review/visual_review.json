  "reviews": [
    {
      "source": "SNL plate33 / p305.jpg",
      "view": "exploded",
      "observations": "The four upper-body bolt sets and ten cover sets now occupy their separate flange joints. Exploded offsets are illustrative only. SNL24/HB203 bolt-length conflict remains documented."
    },
    {
      "source": "LIB30",
      "view": "relief",
      "observations": "Seat, mushroom stem, spring, cage and lower guide are separate. Cage-to-bolt attachment follows HB87; exact hole, route and two-turn tail are estimated. Only the viewing cut removes cage material."
    },
    {
      "source": "LIB34",
      "view": "lower_service",
      "observations": "The four underside nut-access wells now expose the upper-body hardware, consistent with the required HB87 access. The source shows more contoured surrounding bosses than the current broad planar ceiling. Those casting contours still need refinement. Mounting holes and external hose fittings are not yet present."
    },
    {
      "source": "LIB27 and SNL33",
      "view": "gear_core",
      "observations": "Two lower gears, three upper gears and their independent idler pins remain represented. Twelve-tooth involutes and profiles are estimates, not a measured historical tooth count."
    },
    {
      "source": "LIB29/30 and SNL33",
      "view": "cutaway",
      "observations": "Separate strainer frames and coarse porous BRep screens remain explicit approximations. Actual weave, mesh count and filtration rating remain unknown. The retained lock wire in this display is not a service pose."
    },
    {
      "source": "SNL33 and LIB34",
      "view": "isometric",
      "observations": "New perimeter fasteners improve the assembled silhouette. Short cast port openings still await the production connection decision; the pump is not installed in the engine."
    }
  ],
  "not_historical_accuracy_certification": true
