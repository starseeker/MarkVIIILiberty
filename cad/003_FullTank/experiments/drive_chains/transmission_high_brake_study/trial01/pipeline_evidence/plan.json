  "stages": [
    {
      "id": "build",
      "needs": [],
      "reentrant": false,
      "timeout_seconds": 1200,
      "command": [
        "{python}",
        "{root}/skills/freecad-reconstruction/scripts/freecad_headless.py",
        "--workdir",
        "{run}/runtime/build",
        "{root}/cad/003_FullTank/experiments/drive_chains/build_transmission_high_brake_bands.py",
        "--output",
        "{run}/candidate"
      ],
      "python_sources": [
        "{root}/cad/003_FullTank/experiments/drive_chains/build_transmission_high_brake_bands.py"
      ],
      "inputs": [
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/PowertrainWithBrakeSpacers.FCStd",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/report.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/qualification.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/isolated/manifest.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_stop_study/trial04/isolated/breps/2b86be519420bbbd3ce490247fd6aae381295388026d50c8c6982f895e9e768d.brep",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_high_brake_study/source_inventory.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_high_brake_study/band_controls.json",
        "{root}/references/1925-03-06_Preliminary_Handbook_Mark_VIII_Tank/Handbook_Project/proofs/checkpoint08/source-153-156.jpg",
        "{root}/references/1928-03-30_SNL_G13/SNL_G13_Project/sources/p008.jpg",
        "{root}/references/1928-03-30_SNL_G13/SNL_G13_Project/sources/p009.jpg",
        "{root}/references/1928-03-30_SNL_G13/SNL_G13_Project/sources/p118.jpg",
        "{root}/references/1925-03-06_Preliminary_Handbook_Mark_VIII_Tank/Handbook_Project/assets/plate99.png",
        "{root}/references/1928-03-30_SNL_G13/SNL_G13_Project/sources/p119.jpg",
        "{root}/references/1928-03-30_SNL_G13/SNL_G13_Project/sources/p302.jpg",
        "{root}/references/1925-03-06_Preliminary_Handbook_Mark_VIII_Tank/Handbook_Project/assets/plate100.png",
        "{root}/references/1925-03-06_Preliminary_Handbook_Mark_VIII_Tank/Handbook_Project/assets/plate133.png"
      ],
      "outputs": [
        "{run}/candidate/PowertrainWithHighBrakeBands.FCStd",
        "{run}/candidate/report.json",
        "{run}/candidate/changed_shapes/*.brep",
        "{run}/candidate/frozen_inputs/*"
      ]
    },
    {
      "id": "extract",
      "needs": [
        "build"
      ],
      "reentrant": true,
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "{root}/skills/freecad-reconstruction/scripts/freecad_headless.py",
        "--workdir",
        "{run}/runtime/extract",
        "{root}/cad/003_FullTank/experiments/drive_chains/pump_integration_worker.py",
        "extract",
        "--input",
        "{run}/candidate/PowertrainWithHighBrakeBands.FCStd",
        "--output",
        "{run}/candidate/isolated/manifest.json"
      ],
      "python_sources": [
        "{root}/cad/003_FullTank/experiments/drive_chains/pump_integration_worker.py"
      ],
      "inputs": [
        "{run}/candidate/PowertrainWithHighBrakeBands.FCStd"
      ],
      "outputs": [
        "{run}/candidate/isolated/manifest.json",
        "{run}/candidate/isolated/breps/*.brep"
      ]
    },
    {
      "id": "check",
      "needs": [
        "extract"
      ],
      "reentrant": true,
      "timeout_seconds": 1200,
      "command": [
        "{python}",
        "{root}/skills/freecad-reconstruction/scripts/freecad_headless.py",
        "--workdir",
        "{run}/runtime/check",
        "{root}/cad/003_FullTank/experiments/drive_chains/check_transmission_high_brake_bands.py",
        "--candidate",
        "{run}/candidate"
      ],
      "python_sources": [
        "{root}/cad/003_FullTank/experiments/drive_chains/check_transmission_high_brake_bands.py"
      ],
      "inputs": [
        "{run}/candidate/PowertrainWithHighBrakeBands.FCStd",
        "{run}/candidate/report.json",
        "{run}/candidate/isolated/manifest.json",
        "{run}/candidate/isolated/breps/*.brep",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/PowertrainWithBrakeSpacers.FCStd",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/report.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/qualification.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_spacer_study/trial01/isolated/manifest.json",
        "{root}/cad/003_FullTank/experiments/drive_chains/transmission_brake_stop_study/trial04/isolated/breps/2b86be519420bbbd3ce490247fd6aae381295388026d50c8c6982f895e9e768d.brep"
      ],
      "outputs": [
        "{run}/candidate/independent_checks.json"
      ],
      "receipts": [
        {
          "file": "{run}/candidate/independent_checks.json",
          "checks": [
            {
              "pointer": "/passed",
              "equals": true
            },
            {
              "pointer": "/native_sha256",
              "sha256_file": "{run}/candidate/PowertrainWithHighBrakeBands.FCStd"
            }
          ]
        }
      ]
    },
    {
      "id": "render",
      "needs": [
        "check"
      ],
      "reentrant": true,
      "timeout_seconds": 900,
      "command": [
        "{python}",
        "{root}/skills/freecad-reconstruction/scripts/freecad_headless.py",
        "--workdir",
        "{run}/runtime/render",
        "{root}/cad/003_FullTank/experiments/drive_chains/render_transmission_high_brake_bands.py",
        "--candidate",
        "{run}/candidate"
      ],
      "python_sources": [
        "{root}/cad/003_FullTank/experiments/drive_chains/render_transmission_high_brake_bands.py"
      ],
      "inputs": [
        "{run}/candidate/PowertrainWithHighBrakeBands.FCStd",
        "{run}/candidate/report.json",
        "{run}/candidate/isolated/manifest.json",
        "{run}/candidate/isolated/breps/*.brep",
        "{root}/cad/003_FullTank/lib/raster.c"
      ],
      "outputs": [
        "{run}/candidate/isometric.png",
        "{run}/candidate/isometric.svg",
        "{run}/candidate/high_brake_detail.png",
        "{run}/candidate/high_brake_detail.svg",
        "{run}/candidate/render_receipt.json"
      ]
    }
  ]
