            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="the decreased resistance to cranking or by the hissing sound due to"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="32891.05" OwnPage="50" ItemID="291273184" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p051-text-0466" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="32891.05" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
