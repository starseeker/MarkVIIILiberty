            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 6"/>
                <ITEXT CH="ENGINE-OIL SYSTEM"/>
                <trail PARENT="Batch03 Style 6"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="35142.625" OwnPage="53" ItemID="295307104" PTYPE="4" WIDTH="316" HEIGHT="18.77" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p054-text-0539" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 18.77 L0 18.77 L0 0 Z" copath="M0 0 L316 0 L316 18.77 L0 18.77 L0 0 Z" gXpos="140" gYpos="35142.625" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 19" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 19"/>
                <ITEXT CH="(54)"/>
                <trail PARENT="Batch03 Style 19"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="35237.5" OwnPage="54" ItemID="295331072" PTYPE="4" WIDTH="316" HEIGHT="22" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0540" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 22 L0 22 L0 0 Z" copath="M0 0 L316 0 L316 22 L0 22 L0 0 Z" gXpos="140" gYpos="35237.5" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 1"/>
                <ITEXT CH="55"/>
                <trail PARENT="Batch03 Style 1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35263.925" OwnPage="54" ItemID="295354496" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0541" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35263.925" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="is functioning properly, screw down the pressure regulator adjusting"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35274.95" OwnPage="54" ItemID="295423584" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0542" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35274.95" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="screw. This should cause the pressure in the tank to rise if the pump"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35286.2" OwnPage="54" ItemID="295470608" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0543" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35286.2" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="is operating as it should. Now screw the regulator adjustment up"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35297.45" OwnPage="54" ItemID="295453072" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0544" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35297.45" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="until the pressure is held steadily at 3 to 4 pounds."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35308.7" OwnPage="54" ItemID="295519008" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0545" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35308.7" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT FONT="C059 Italic" CH="Note water circulation."/>
                <ITEXT CH="—Temperature gauge should show a steady"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35320.175" OwnPage="54" ItemID="295587360" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0546" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35320.175" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="rise up to not to exceed 200° F. The most efficient temperature"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35331.425" OwnPage="54" ItemID="295633744" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0547" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35331.425" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="will vary with weather conditions, but will average 180° F."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35342.675" OwnPage="54" ItemID="295709168" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0548" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35342.675" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT FONT="C059 Italic" CH="Note ammeter reading."/>
                <ITEXT CH="—At idling speeds the ammeter needle will"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35353.925" OwnPage="54" ItemID="295819040" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0549" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35353.925" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="stand on the “discharge” side of zero. At about 650 r. p. m., with"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35365.175" OwnPage="54" ItemID="295891344" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0550" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35365.175" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="both switches “on,” the needle will stand at zero, and at high speeds"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35376.425" OwnPage="54" ItemID="295935984" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0551" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35376.425" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="it should stand on the “charge” side of zero."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35387.675" OwnPage="54" ItemID="295994304" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0552" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35387.675" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="When the engine is well warmed up the throttle may be opened"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35398.925" OwnPage="54" ItemID="296200032" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0553" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35398.925" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="partially (neutral gears) and the speed of the engine noted. Tacho-"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35409.725" OwnPage="54" ItemID="296066336" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0554" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35409.725" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="meter should show not over 1,350 to 1,400 r. p. m."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35420.8625" OwnPage="54" ItemID="296128432" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0555" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35420.8625" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="Operation of each ignition head should be tested separately by"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35431.55" OwnPage="54" ItemID="297008048" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0556" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35431.55" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="shutting off first one switch and then the other. The engine should"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35442.575" OwnPage="54" ItemID="297052368" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0557" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35442.575" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="show the same r. p. m. in each case. With the throttle wide open,"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35453.375" OwnPage="54" ItemID="297034912" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0558" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35453.375" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="whether the engine is running on one or both sets will make very"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35464.625" OwnPage="54" ItemID="297088192" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0559" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35464.625" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="little difference in the speed (possible 10 or 15 r. p. m.). At lower"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35475.875" OwnPage="54" ItemID="297191616" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0560" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35475.875" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="speeds (600 to 800 r. p. m.) the effect will be more apparent."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35487.2375" OwnPage="54" ItemID="297245888" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0561" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35487.2375" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="Before stopping the engine, throttle it down to idling speed for a"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35498.6" OwnPage="54" ItemID="297314832" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0562" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35498.6" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="minute ot two, then turn the ignition switches to “off,” and at the"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35510.075" OwnPage="54" ItemID="297296112" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0563" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35510.075" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="same time open the throttle wide. Opening the throttle will “choke”"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35521.325" OwnPage="54" ItemID="297349136" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0564" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35521.325" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="the engine and cause it to stop immediately. Allowing the throttle"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35532.8" OwnPage="54" ItemID="297452096" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0565" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35532.8" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="to remain in the idling position may permit an overheated plug or"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35544.05" OwnPage="54" ItemID="297528432" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0566" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35544.05" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="particle of carbon to fire the engine spasmodically for some time after"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35555.3" OwnPage="54" ItemID="297581968" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0567" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35555.3" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="the ignition is cut off."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="35566.55" OwnPage="54" ItemID="297565072" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0568" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="35566.55" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT FONT="C059 Italic" CH="Caution."/>
                <ITEXT CH="—Do not attempt to crank an engine immediately after"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35578.025" OwnPage="54" ItemID="297604368" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0569" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35578.025" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="it has been stopped. An overheated plug or incandescent particle"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35589.275" OwnPage="54" ItemID="297702784" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0570" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35589.275" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="of carbon might cause preignition and a disastrous back kick. Allow"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="35600.75" OwnPage="54" ItemID="297683696" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p055-text-0571" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="35600.75" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="it to cool off for a few minutes."/>
                <trail PARENT="Batch03 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
