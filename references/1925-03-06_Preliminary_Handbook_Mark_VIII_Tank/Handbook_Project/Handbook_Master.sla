            <StoryText>
                <DefaultStyle PARENT="Batch07 Style 3"/>
                <ITEXT CPARENT="Batch07 Note small capitals" CH="Note"/>
                <ITEXT CH=".—It must be remembered in replacing the chain that the"/>
