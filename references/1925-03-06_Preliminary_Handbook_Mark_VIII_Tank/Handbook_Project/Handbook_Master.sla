                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="9554" OwnPage="14" ItemID="241712752" PTYPE="4" WIDTH="316" HEIGHT="15.35" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1211" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" copath="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" gXpos="140" gYpos="9554" gWidth="0" gHeight="0" PSTYLE="Style 47" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 47"/>
                <ITEXT CH="TO REVERSE MACHINE"/>
                <trail PARENT="Style 47"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9561.25" OwnPage="14" ItemID="241790576" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1212" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9561.25" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="1. Put both shifting levers in neutral."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9571.825" OwnPage="14" ItemID="241812960" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1213" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9571.825" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="2. Pull clutch lever back as far as it will go."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9582.85" OwnPage="14" ItemID="241887552" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1214" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9582.85" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="3. When sure that cardan shift has stopped running, shift to reverse"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="9593.425" OwnPage="14" ItemID="241845824" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1215" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="9593.425" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="by putting reverse lever in position (as shown on page 151)."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9604.9" OwnPage="14" ItemID="241909040" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1216" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9604.9" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="4. Engage both low gears."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9615.925" OwnPage="14" ItemID="242020704" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1217" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9615.925" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="5. Let clutch in gradually."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="9631.4" OwnPage="14" ItemID="242070304" PTYPE="4" WIDTH="316" HEIGHT="15.35" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1218" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" copath="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" gXpos="140" gYpos="9631.4" gWidth="0" gHeight="0" PSTYLE="Style 47" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 47"/>
                <ITEXT CH="TO STEER MACHINE"/>
                <trail PARENT="Style 47"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9638.2" OwnPage="14" ItemID="242038720" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1219" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9638.2" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="To turn, put track on side toward which it is desired to turn into"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="9649.225" OwnPage="14" ItemID="242126128" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1220" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="9649.225" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="neutral. If machine does not turn quickly, but moves ahead, de-"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="9660.7" OwnPage="14" ItemID="242093552" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1221" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="9660.7" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="press foot pedal."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="9671.05" OwnPage="14" ItemID="242167472" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1222" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="9671.05" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="The pedal brake is interconnected with the transmission, so that"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="9681.85" OwnPage="14" ItemID="242195760" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p015-text-1223" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="9681.85" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="the brake can only be applied on the side which is in neutral."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="9809.5" OwnPage="15" ItemID="242259872" PTYPE="4" WIDTH="316" HEIGHT="22" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1224" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 22 L0 22 L0 0 Z" copath="M0 0 L316 0 L316 22 L0 22 L0 0 Z" gXpos="140" gYpos="9809.5" gWidth="0" gHeight="0" PSTYLE="Style 23" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 23"/>
                <ITEXT CH="16"/>
                <trail PARENT="Style 23"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="10119.2" OwnPage="15" ItemID="242282832" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1225" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="10119.2" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="The pedal is a positive brake on the track which is in neutral; it"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="10130" OwnPage="15" ItemID="242400528" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1226" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="10130" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="does not effect a track when it is in low or high gear. Placing the"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="10141.7" OwnPage="15" ItemID="242333552" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1227" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="10141.7" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="lever in neutral allows the brake on that side to be applied when pres-"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="10152.05" OwnPage="15" ItemID="242379792" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1228" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="10152.05" gWidth="0" gHeight="0" PSTYLE="Style 46" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 46"/>
                <ITEXT CH="sure is applied to the pedal."/>
                <trail PARENT="Style 46"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="10171.8" OwnPage="15" ItemID="242419696" PTYPE="4" WIDTH="316" HEIGHT="15.35" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1229" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" copath="M0 0 L316 0 L316 15.35 L0 15.35 L0 0 Z" gXpos="140" gYpos="10171.8" gWidth="0" gHeight="0" PSTYLE="Style 47" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 47"/>
                <ITEXT CH="TO MAKE A WIDE TURN"/>
                <trail PARENT="Style 47"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="160" YPOS="10181.525" OwnPage="15" ItemID="242538304" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1230" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="10181.525" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="To make a wide turn, the track on the side toward which it is"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="10192.55" OwnPage="15" ItemID="242502144" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1231" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="10192.55" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="desired to turn should be in low gear, while the other track should"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="10204.7" OwnPage="15" ItemID="242560528" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p016-text-1232" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="10204.7" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="be in high gear. This allows the track on one side to turn at a faster"/>
                <trail PARENT="Style 45"/>
            </StoryText>
