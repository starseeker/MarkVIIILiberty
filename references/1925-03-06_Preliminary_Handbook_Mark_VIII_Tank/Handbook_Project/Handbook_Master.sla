        <PAGEOBJECT XPOS="160" YPOS="36792.7" OwnPage="56" ItemID="300141904" PTYPE="4" WIDTH="286" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0608" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" copath="M0 0 L286 0 L286 21.43 L0 21.43 L0 0 Z" gXpos="160" gYpos="36792.7" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="The diagnosing of gasoline-engine troubles is largely a matter of"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="36803.725" OwnPage="56" ItemID="300218080" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0609" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="36803.725" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="experience on account of the fact that a symptom may be due to any"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="36814.975" OwnPage="56" ItemID="300172032" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0610" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="36814.975" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="one of a number of causes. A correct conclusion can only be arrived"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="36826.5625" OwnPage="56" ItemID="300228016" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0611" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="36826.5625" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="at by a process of elimination. The different causes, as set forth in"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="36837.925" OwnPage="56" ItemID="300297680" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0612" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="36837.925" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 2"/>
                <ITEXT CH="the table which follows, have been arranged in the order in which"/>
                <trail PARENT="Batch03 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="36848.725" OwnPage="56" ItemID="300416768" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p057-text-0613" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="36848.725" gWidth="0" gHeight="0" PSTYLE="Batch03 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch03 Style 3"/>
                <ITEXT CH="they most frequently occur."/>
                <trail PARENT="Batch03 Style 3"/>
