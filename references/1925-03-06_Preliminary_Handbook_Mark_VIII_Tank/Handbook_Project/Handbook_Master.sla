            <StoryText>
                <DefaultStyle PARENT="Batch06 Style 2"/>
                <ITEXT CH="shaft over in a clockwise direction until the No. 1 exhaust valve is just"/>
                <trail PARENT="Batch06 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="69011.906675" OwnPage="105" ItemID="382198032" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p106-text-0279" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="69011.906675" gWidth="0" gHeight="0" PSTYLE="Batch06 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch06 Style 2"/>
                <ITEXT CH="closed and the inlet valve is just about to open. Locate the gear in"/>
                <trail PARENT="Batch06 Style 2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="69023.345" OwnPage="105" ItemID="382252304" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p106-text-0280" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="69023.345" gWidth="0" gHeight="0" PSTYLE="Batch06 Style 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch06 Style 3"/>
                <ITEXT CH="the same manner as in setting the left cam shaft."/>
                <trail PARENT="Batch06 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
