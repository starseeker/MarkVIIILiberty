            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="180" YPOS="39326" OwnPage="60" ItemID="303802608" PTYPE="4" WIDTH="266" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p061-text-0015" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L266 0 L266 21.43 L0 21.43 L0 0 Z" copath="M0 0 L266 0 L266 21.43 L0 21.43 L0 0 Z" gXpos="180" gYpos="39326" gWidth="0" gHeight="0" PSTYLE="Batch04 Style 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Batch04 Style 2"/>
