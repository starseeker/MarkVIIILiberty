            <StoryText>
                <DefaultStyle PARENT="Batch04 Style 3"/>
                <ITEXT CH="and covers No. 8095 and lay them to one side in the order in which"/>
                <trail PARENT="Batch04 Style 3"/>
            </StoryText>
        </PAGEOBJECT>
