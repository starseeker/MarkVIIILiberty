            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="is for reversing the peddle which is in the center of the track brake."/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="150" YPOS="8934.45" OwnPage="13" ItemID="413552032" PTYPE="4" WIDTH="296" HEIGHT="21.43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p014-text-1166" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" copath="M0 0 L296 0 L296 21.43 L0 21.43 L0 0 Z" gXpos="150" gYpos="8934.45" gWidth="0" gHeight="0" PSTYLE="Style 45" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
