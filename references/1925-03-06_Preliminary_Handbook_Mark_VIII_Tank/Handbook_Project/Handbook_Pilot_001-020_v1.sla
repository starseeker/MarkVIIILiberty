            <StoryText>
                <DefaultStyle PARENT="Style 45"/>
                <ITEXT CH="can be applied so that shifting both levers to neutral permits apply-"/>
                <trail PARENT="Style 45"/>
            </StoryText>
        </PAGEOBJECT>
