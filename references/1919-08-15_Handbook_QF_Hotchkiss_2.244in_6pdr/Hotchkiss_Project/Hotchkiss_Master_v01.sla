            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="12080.5021461217" OwnPage="18" ItemID="791326289" PTYPE="4" WIDTH="340" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line22" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" copath="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" gXpos="152" gYpos="16616.5021461217" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="("/>
                <ITEXT FONT="C059 Italic" CH="c"/>
