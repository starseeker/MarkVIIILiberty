        <PAGEOBJECT XPOS="152" YPOS="4481.98498121886" OwnPage="7" ItemID="780045281" PTYPE="4" WIDTH="340" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line14" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" copath="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" gXpos="152" gYpos="6641.98498121886" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="("/>
                <ITEXT FONT="C059 Italic" CH="a"/>
                <ITEXT CH=") The gun is of British design and manufacture. The body"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4495.01296128785" OwnPage="7" ItemID="793161521" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line15" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6655.01296128785" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="is of alloy steel, built up, and consists of a tube, jacket, recoil band,"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4508.04094135684" OwnPage="7" ItemID="793003073" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line16" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6668.04094135684" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="and locking ring. The jacket is shrunk on and envelops the rear"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4521.46370870065" OwnPage="7" ItemID="792993217" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line17" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6681.46370870065" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="end of the tube, being extended rearwards to allow a recess for the"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4534.49168876964" OwnPage="7" ItemID="792721089" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line18" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6694.49168876964" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-0"/>
                <ITEXT CH="breechblock to be formed in it."/>
                <trail PARENT="C059 Roman-10.8-0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="4547.32227520123" OwnPage="7" ItemID="792697313" PTYPE="4" WIDTH="340" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line19" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" copath="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" gXpos="152" gYpos="6707.32227520123" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="("/>
                <ITEXT FONT="C059 Italic" CH="b"/>
                <ITEXT CH=") The recoil band is screwed on the exterior of the jacket just"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4560.35025527022" OwnPage="7" ItemID="779808913" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line20" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6720.35025527022" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="in front of the breech recess. It is provided with top and bottom"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4573.37823533921" OwnPage="7" ItemID="775800977" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line21" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6733.37823533921" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="lugs for attaching to the recoil and counter-recoil mechanisms, re-"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4586.80100268302" OwnPage="7" ItemID="767081841" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line22" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6746.80100268302" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="spectively. It is secured against turning by two flush set screws, one"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4600.02637638942" OwnPage="7" ItemID="764072657" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line23" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6760.02637638942" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-0"/>
                <ITEXT CH="at each end of the horizontal diameter."/>
                <trail PARENT="C059 Roman-10.8-0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="4613.05435645841" OwnPage="7" ItemID="762841249" PTYPE="4" WIDTH="340" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line24" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" copath="M0 0 L340 0 L340 20.736 L0 20.736 L0 0 Z" gXpos="152" gYpos="6773.05435645841" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="("/>
                <ITEXT FONT="C059 Italic" CH="c"/>
                <ITEXT CH=") The jacket and tube are secured longitudinally by the front"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4625.29276197777" OwnPage="7" ItemID="759995825" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line25" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6785.29276197777" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="end of the jacket seating against a shoulder on the tube and the"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4638.32074204676" OwnPage="7" ItemID="799094001" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line26" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6798.32074204676" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="locking ring being screwed and shrunk on both the tube and jacket"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="4651.94090302798" OwnPage="7" ItemID="758379057" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p7-line27" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="6811.94090302798" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-0"/>
                <ITEXT CH="over this shoulder seat, thus locking these parts together."/>
                <trail PARENT="C059 Roman-10.8-0"/>
            </StoryText>
