        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="11966.1049784358" OwnPage="18" ItemID="790827681" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line13" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16502.1049784358" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="there is not room for enough correction, a new zero point must be"/>
