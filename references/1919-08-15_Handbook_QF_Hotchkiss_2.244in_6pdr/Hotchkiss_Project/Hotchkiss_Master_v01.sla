                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="piration of at least one minute. The gun may be immediately"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
