        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="11978.6403823624" OwnPage="18" ItemID="783617921" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line14" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16514.6403823624" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4" SCALEH="99.9"/>
                <ITEXT SCALEH="99.9" CH="marked on the deflection scale, or the gunner must remember the zero"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="11991.3614959768" OwnPage="18" ItemID="801407617" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line15" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16527.3614959768" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="of his scale. If there is an error in elevation, lay the telescope on"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12003.9897547473" OwnPage="18" ItemID="767888801" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line16" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16539.9897547473" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="the target by moving the range drum. Then to make the range drum"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12016.4323038301" OwnPage="18" ItemID="769975633" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line17" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16552.4323038301" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="read zero the three screws which hold the scale on the drum must be"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12029.4319819762" OwnPage="18" ItemID="777608337" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line18" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16565.4319819762" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT FONT="C059 Italic" CH="slackened, not removed"/>
                <ITEXT CH=", and the scale adjusted until the zero is in"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12042.0602407467" OwnPage="18" ItemID="780568625" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line19" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16578.0602407467" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="the correct position and the three screws then tightened. Never re-"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12054.7813543611" OwnPage="18" ItemID="782488561" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line20" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16590.7813543611" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-4" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-4"/>
                <ITEXT CH="move these screws. When this is finished check the alignment of the"/>
                <trail PARENT="C059 Roman-10.8-4"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140" YPOS="12067.5024679755" OwnPage="18" ItemID="790329553" PTYPE="4" WIDTH="352" HEIGHT="20.736" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p18-line21" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" copath="M0 0 L352 0 L352 20.736 L0 20.736 L0 0 Z" gXpos="140" gYpos="16603.5024679755" gWidth="0" gHeight="0" PSTYLE="C059 Roman-10.8-0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="C059 Roman-10.8-0"/>
