        <PAGEOBJECT XPOS="146" YPOS="68286.3431061807" OwnPage="93" ItemID="1318284995" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0094-text-0432" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="68286.3431061807" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
