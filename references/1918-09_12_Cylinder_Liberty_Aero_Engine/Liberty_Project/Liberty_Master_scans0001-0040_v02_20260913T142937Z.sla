            <StoryText>
                <DefaultStyle PARENT="Liberty b01 30"/>
                <ITEXT CH="the level of the main bearing centres, as usual. There"/>
                <trail PARENT="Liberty b01 30"/>
            </StoryText>
        </PAGEOBJECT>
