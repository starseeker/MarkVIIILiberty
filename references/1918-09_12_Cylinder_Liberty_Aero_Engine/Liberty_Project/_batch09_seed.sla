        </PAGEOBJECT>
        <PAGEOBJECT XPOS="172.148969889065" YPOS="95252.3858954041" OwnPage="130" ItemID="902625561" PTYPE="4" WIDTH="277.851030110935" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0131-text-0293" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L277.851 0 L277.851 23.52 L0 23.52 L0 0 Z" copath="M0 0 L277.851 0 L277.851 23.52 L0 23.52 L0 0 Z" gXpos="172.148969889065" gYpos="95252.3858954041" gWidth="0" gHeight="0" PSTYLE="Liberty b07 2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
