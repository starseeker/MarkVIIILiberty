            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67364.1418383518" OwnPage="92" ItemID="1489440187" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0364" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67364.1418383518" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="up as quickly as possible to about 700 r.p.m. on one igni-" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67375.4381933439" OwnPage="92" ItemID="1658935259" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0365" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67375.4381933439" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="tion only: if all is well with the lubrication and cooling" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67386.734548336" OwnPage="92" ItemID="1461051675" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0366" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67386.734548336" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="system, and the engine is running passably well, the" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67398.0309033281" OwnPage="92" ItemID="1504265483" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0367" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67398.0309033281" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="second ignition should be switched on and the speed" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67409.3272583201" OwnPage="92" ItemID="1490777483" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0368" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67409.3272583201" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="increased until the ammeter shows at least 6 amperes" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67420.6236133122" OwnPage="92" ItemID="1630077243" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0369" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67420.6236133122" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="charge rate, or even 8 or 10 amperes in extreme cases." />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67431.9199683043" OwnPage="92" ItemID="1629606747" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0370" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67431.9199683043" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Liberty b05 3" />
                <ITEXT CH="This should be continued for about half an hour, when" />
                <trail PARENT="Liberty b05 3" />
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="146" YPOS="67443.2163232964" OwnPage="92" ItemID="1552845755" PTYPE="4" WIDTH="304" HEIGHT="23.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="scan0093-text-0371" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="2" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" copath="M0 0 L304 0 L304 23.52 L0 23.52 L0 0 Z" gXpos="146" gYpos="67443.2163232964" gWidth="0" gHeight="0" PSTYLE="Liberty b05 3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
